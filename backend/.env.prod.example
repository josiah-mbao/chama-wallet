# Production Environment Configuration for Chama Wallet API
# Copy this file to .env.prod and update with your production values

# Database Configuration
DATABASE_URL="postgresql+psycopg2://chamauser:CHANGE_THIS_PASSWORD@db:5432/chamadb"
DB_USER="chamauser"
DB_PASSWORD="CHANGE_THIS_PASSWORD"
DB_NAME="chamadb"

# Redis Configuration
REDIS_URL="redis://redis:6379/0"

# Security Configuration
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_64_CHARACTER_KEY_GENERATED_WITH_secrets.token_hex(32)"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Paystack Payment Integration (Production Keys)
PAYSTACK_SECRET_KEY="sk_live_CHANGE_THIS_TO_YOUR_PRODUCTION_SECRET_KEY"
PAYSTACK_PUBLIC_KEY="pk_live_CHANGE_THIS_TO_YOUR_PRODUCTION_PUBLIC_KEY"
PAYSTACK_WEBHOOK_SECRET="whsec_CHANGE_THIS_TO_YOUR_WEBHOOK_SECRET"

# SSL/HTTPS Configuration
ENABLE_HTTPS=true
SSL_CERT_PATH="/app/ssl/cert.pem"
SSL_KEY_PATH="/app/ssl/key.pem"
FORCE_HTTPS_REDIRECT=true

# Security Headers Configuration
ENABLE_SECURITY_HEADERS=true
CSP_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# CORS Configuration (Production domains)
CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Logging Configuration
LOG_LEVEL="INFO"
ENABLE_FILE_LOGGING="true"

# Grafana Credentials
GRAFANA_USER="admin"
GRAFANA_PASSWORD="CHANGE_THIS_TO_A_SECURE_PASSWORD"

# Application Settings
ENV_FILE="/app/backend/.env.prod"
