# Railway Environment Configuration for Chama Wallet API
# This file contains Railway-specific environment variables
# Railway automatically provides DATABASE_URL and REDIS_URL

# Application Settings
ENV_FILE=/app/backend/.env.railway
ENV=production

# Security Configuration (Set these in Railway dashboard)
SECRET_KEY=your_secure_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Paystack Payment Integration (Production Keys)
PAYSTACK_SECRET_KEY=sk_live_your_production_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_production_public_key
PAYSTACK_WEBHOOK_SECRET=whsec_your_webhook_secret

# SSL/HTTPS Configuration
ENABLE_HTTPS=true
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem
FORCE_HTTPS_REDIRECT=true

# Security Headers Configuration
ENABLE_SECURITY_HEADERS=true
CSP_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# CORS Configuration (Update with your Railway domain)
CORS_ORIGINS=https://your-app-name.railway.app,https://www.your-app-name.railway.app

# Logging Configuration
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true

# Railway Services
# DATABASE_URL is automatically provided by Railway PostgreSQL service
# REDIS_URL is automatically provided by Railway Redis service

# Database Configuration (Railway provides these automatically)
# DB_USER, DB_PASSWORD, DB_NAME are extracted from DATABASE_URL at runtime

# Redis Configuration (Railway provides this automatically)
# REDIS_URL is provided by Railway Redis service

# Monitoring (Optional - Railway has built-in monitoring)
# PROMETHEUS_URL can be added if you want external monitoring
